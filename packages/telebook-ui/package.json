{
  "name": "@telebook/ui",
  "version": "0.0.1",
  "description": "Telegram-opinionated Vue 3 UI kit for Mini Apps",
  "author": "Specc (https://github.com/neSpecc)",
  "repository": "https://github.com/neSpecc/telebook",
  "homepage": "https://github.com/neSpecc/telebook",
  "type": "module",
  "main": "./dist/telebook-ui.js",
  "module": "./dist/telebook-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/telebook-ui.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/telebook-ui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "@twa-dev/sdk": "^6.9",
    "@vueuse/core": "^10",
    "normalize.css": "^8",
    "vue": "^3.3",
    "vue-router": "^4",
    "vue3-lottie": "^3"
  },
  "devDependencies": {
    "@types/node": "^20.7.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "postcss": "^8.4.31",
    "postcss-apply": "^0.12.0",
    "postcss-nested": "^6.0.1",
    "postcss-preset-env": "^9.1.4",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vite-plugin-dts": "^3.7.3",
    "vue": "^3.3.4",
    "vue-tsc": "^1.8.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
